# Database
DATABASE_URL="postgresql://ministerial_user:YOUR_PASSWORD_HERE@localhost:5432/ministerial_command_center?schema=public"

# JWT Secrets (Generate with: openssl rand -hex 64)
JWT_SECRET="your-jwt-secret-key-here-64-characters-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-here-64-characters-long"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"  # 30-day refresh for "Remember Me" functionality

# Application
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:8080,https://your-domain.example"

# Public URL of the frontend. Used for QR codes printed on official documents,
# email links and signature links — set it or those point at localhost.
APP_URL="https://your-domain.example"
FRONTEND_URL="https://your-domain.example"

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@mttsia.gob.gq"

# Cloudflare R2 Storage (S3-compatible)
# NOTE: this file is committed to git — it must only ever contain placeholders.
# Real values belong in .env, which is gitignored.
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="ministerial-documents"
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://YOUR_CUSTOM_DOMAIN"
R2_REGION="auto"

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="pdf,doc,docx,jpg,jpeg,png,txt"
MAX_FILES_PER_DOCUMENT=10

# OpenAI API (for OCR and AI features)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"
OPENAI_VISION_MODEL="gpt-4o"
ENABLE_AI_FEATURES=true

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
